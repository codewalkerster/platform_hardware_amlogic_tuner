package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_interfaces_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_amlogic_tuner_aidl_license"],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
// See: http://go/android-license-faq
license {
    name: "hardware_amlogic_tuner_aidl_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
        "SPDX-license-identifier-FTL",
        "SPDX-license-identifier-GPL",
        "SPDX-license-identifier-LGPL-2.1",
        "SPDX-license-identifier-MIT",
        "legacy_by_exception_only", // by exception only
        "legacy_notice",
    ],
    license_text: [
        "LICENSE",
    ],
}

bootstrap_go_package {
    name: "soong-droidlogic_tuner_hal_aidl",
    pkgPath: "android/soong/droidlogic_tuner_hal_aidl",
    deps: [
    "blueprint",
    "blueprint-pathtools",
    "soong",
    "soong-android",
    "soong-cc",
    "soong-genrule",
    ],
    srcs: [
        "droidlogic_tuner_hal.go",
    ],
    pluginFor: ["soong_build"],
}

droidlogic_tuner_hal_aidl_defaults {
    name: "droidlogic_tuner_hal_aidl_defaults",
}

cc_defaults {
    name: "tuner_hal_service_defaults",
	defaults: ["droidlogic_tuner_hal_aidl_defaults"],
    relative_install_path: "hw",
    vintf_fragments: ["android.hardware.tv.tuner-service.droidlogic.xml"],
    vendor: true,
    compile_multilib: "first",
    srcs: [
        //"utils/TSPMessage.cpp",
        "utils/TSPLooper.cpp",
        "utils/TSPLooperRoster.cpp",
        //"utils/String8.cpp",
        //"utils/String16.cpp",
        //"utils/Unicode.cpp",
        "utils/SharedBuffer.cpp",
        "utils/VectorImpl.cpp",
        "utils/Threads.cpp",
        "utils/Timers.cpp",
        "utils/FileSystemIo.cpp",
        "utils/stbtrace.cpp",
        "dsc/dsc_dev.c",
        "frontenddevices/HwFeState.cpp",
        "frontenddevices/FrontendDvbtDevice.cpp",
        "frontenddevices/FrontendDevice.cpp",
        "frontenddevices/FrontendAnalogDevice.cpp",
        "frontenddevices/FrontendAtscDevice.cpp",
        "frontenddevices/FrontendAtsc3Device.cpp",
        "frontenddevices/FrontendDvbcDevice.cpp",
        "frontenddevices/FrontendDvbsDevice.cpp",
        "frontenddevices/FrontendIsdbtDevice.cpp",
        "frontenddevices/FrontendDtmbDevice.cpp",
        "MultiHwDemux/AmDmx.cpp",
        "MultiHwDemux/AmLinuxDvb.cpp",
        "MultiHwDemux/AmPesFilter.cpp",
        "MultiHwDemux/HwDemuxSCWrap.cpp",
        //"MultiHwDemux/AmTsIndexer.cpp",
        "MultiHwDemux/ParseTEMIData.cpp",
        "mediasync/MediaSyncWrap.cpp",
        //"dvr/AmDvr.cpp",
        "dvr/dvr_record.c",
        "dvr/dvr_playback.c",
        "dvr/ts_indexer.c",
        "dvr/dvb_utils.c",
        "Demux.cpp",
        "Descrambler.cpp",
        "Dvr.cpp",
        "Filter.cpp",
        "Frontend.cpp",
        "Lnb.cpp",
        "TimeFilter.cpp",
        "Tuner.cpp",
        "service.cpp",
    ],
    static_libs: [
        "libaidlcommonsupport",
    ],
    shared_libs: [
        "android.hardware.common.fmq-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libdmabufheap",
        "libfmq",
        "libion",
        "liblog",
        "libutils",
        "libsystemcontrolservice",
        "vendor.amlogic.hardware.systemcontrol@1.0",
        "vendor.amlogic.hardware.systemcontrol@1.1",
        "libjsoncpp",
        "libdsm",
        "libmediahal_mediasync",
    ],
    header_libs: [
        "media_plugin_headers",
    ],

    local_include_dirs: [
        "MultiHwDemux",
        "mediasync",
        "dvr",
        "dsc",
        "utils",
    ],

    cflags: [
        "-Wno-unused-parameter",
        "-Wall",
        "-Wno-unused-function",
        "-Wno-deprecated-declarations",
        "-Wno-deprecated-register",
    ],

    cppflags: [
       //"-DTUNERHAL_DBG",
    ],

    product_variables: {
        platform_sdk_version: {
            cflags: ["-DPLATFORM_SDK_VERSION=%d"],
        }
    },

    include_dirs: [
        "hardware/amlogic/tuner/aidl/frontenddevices",
        "vendor/amlogic/common/frameworks/services/systemcontrol",
        "vendor/amlogic/common/frameworks/services/systemcontrol/PQ/include",
    ],
    arch: {
        x86: {
            enabled: false,
        },
        x86_64: {
            enabled: false,
        },
    }
}

cc_binary {
    name: "android.hardware.tv.tuner-service.droidlogic",
    defaults: ["tuner_hal_service_defaults"],
    init_rc: ["android.hardware.tv.tuner-service.droidlogic.rc"],
}

cc_binary {
    name: "android.hardware.tv.tuner-service.droidlogic-lazy",
    defaults: ["tuner_hal_service_defaults"],
    init_rc: ["android.hardware.tv.tuner-service.droidlogic-lazy.rc"],
    cflags: [
        "-DLAZY_HAL",
    ],
}

