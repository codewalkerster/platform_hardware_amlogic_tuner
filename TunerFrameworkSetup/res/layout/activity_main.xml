<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autofillHints="Frequency Mhz"
    android:background="#808080"
    android:orientation="horizontal">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="0dp"
        android:layout_weight="7">
        <RelativeLayout
            android:id="@+id/rl_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <SurfaceView
                android:id="@+id/play_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_flt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true">
            <SurfaceView
                android:id="@+id/play_view_flt"
                android:layout_width="420dp"
                android:layout_height="270dp" />
        </RelativeLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:background="@drawable/right_panel_selector">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stream Mode:"
                android:textColor="#FF000000"/>

            <Spinner
                android:id="@+id/spinner_stream_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:entries="@array/stream_modes" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_frequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_frequency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Frequency:"
                android:textColor="#FF000000"/>

            <EditText
                android:id="@+id/frequency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:gravity="center"
                android:hint="Mhz"
                android:inputType="number"
                android:text=""/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_video_pid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Video Pid:"
                android:textColor="#FF000000"/>

            <EditText
                android:id="@+id/video_pid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:gravity="center"
                android:hint="number"
                android:inputType="number"
                android:text=""/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_audio_pid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Audio Pid:"
                android:textColor="#FF000000"/>

            <EditText
                android:id="@+id/audio_pid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:gravity="center"
                android:hint="number"
                android:inputType="number"
                android:text=""/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_local_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_ts_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TS File:"
                android:textColor="#FF000000"/>

            <EditText
                android:id="@+id/ts_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="text"
                android:inputType="text"
                android:text=""/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_channel_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_channel_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Channel Id:"
                android:textColor="#FF000000"/>

            <EditText
                android:id="@+id/channel_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:gravity="center"
                android:hint="number"
                android:inputType="number"
                android:text=""/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_symbol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Symbol:"
                android:textColor="#FF000000"/>

            <EditText
                android:id="@+id/edit_symbol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:gravity="center"
                android:hint="number"
                android:inputType="number"
                android:text=""/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_scanmode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scan Mode:"
                android:textColor="#FF000000"/>

            <Spinner
                android:id="@+id/spinner_scan_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:entries="@array/scan_modes" />

        </LinearLayout>

        <Button
            android:id="@+id/search_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="search start"/>

        <Button
            android:id="@+id/search_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="search stop"
            android:visibility="gone"/>

        <Button
            android:id="@+id/play_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="play start"
            android:visibility="gone"/>

        <Button
            android:id="@+id/play_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="play stop"/>

        <Button
            android:id="@+id/local_play_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="local play start"
            android:visibility="gone"/>

        <Button
            android:id="@+id/local_play_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="local play stop"
            android:visibility="gone"/>

       <LinearLayout
            android:id="@+id/layout_local_file2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_ts_file2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TS File:"
                android:textColor="#FF000000"/>

            <EditText
                android:id="@+id/ts_file2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="text"
                android:inputType="text"
                android:text=""/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_channel_id2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_channel_id2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Channel Id:"
                android:textColor="#FF000000"/>

            <EditText
                android:id="@+id/channel_id2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:gravity="center"
                android:hint="number"
                android:inputType="number"
                android:text=""/>
        </LinearLayout>

        <Button
            android:id="@+id/local_play_start2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="local play start"/>

        <Button
            android:id="@+id/local_play_stop2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="local play stop"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Status"
            android:textColor="#FF000000"/>

    </LinearLayout>

</LinearLayout>